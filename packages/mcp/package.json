{
  "name": "@infona-ai/mcp",
  "version": "0.1.13",
  "description": "Infona MCP server — expose context graph tools to AI agents",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "infona-mcp": "./dist/index.js",
    "onta-mcp": "./dist/index.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepack": "node ../../scripts/chmod-bin.js packages/mcp/dist/index.js"
  },
  "keywords": [
    "knowledge-graph",
    "context-graph",
    "infona",
    "mcp",
    "model-context-protocol",
    "ai",
    "llm",
    "agent"
  ],
  "author": "Infona",
  "license": "Apache-2.0",
  "homepage": "https://infona.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/infona-ai/infona-oss.git",
    "directory": "packages/mcp"
  },
  "bugs": {
    "url": "https://github.com/infona-ai/infona-oss/issues"
  },
  "dependencies": {
    "@infona-ai/cli": "^0.1.0",
    "@modelcontextprotocol/sdk": "^1.0.4",
    "zod": "^3.23.8"
  },
  "engines": {
    "node": ">=20"
  }
}
