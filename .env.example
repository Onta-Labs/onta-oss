# Graph database backend: "neptune" or "fuseki"
INFONA_GRAPH_BACKEND=fuseki
INFONA_NEPTUNE_ENDPOINT=http://localhost:3030

# ---------------------------------------------------------------------------
# Neo4j property graph (ADR 0012 Wave 1 — optional until cutover)
# ---------------------------------------------------------------------------
# BYOK / local only. `docker compose up -d neo4j` starts Community 5.x with the
# password below. The GraphStore factory (get_graph_store) reads these env vars;
# the OSS package never ships a platform or managed key.
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=infona-dev-password
# NEO4J_DATABASE=neo4j

# LLM API keys (at least one required)
OPENROUTER_API_KEY=sk-or-...

# Optional: for type matching (falls back to OpenRouter if not set)
# INFONA_ANTHROPIC_API_KEY=sk-ant-...

# Optional: for fast inference
# INFONA_CEREBRAS_API_KEY=csk-...

# Query path defaults: when only OPENROUTER_API_KEY is set, the server
# auto-selects openrouter + google/gemini-2.5-flash. Override explicitly:
# INFONA_QUERY_PROVIDER=openrouter
# INFONA_QUERY_MODEL=google/gemini-2.5-flash
# INFONA_QUERY_PROVIDER=cerebras
# INFONA_QUERY_MODEL=llama3.1-8b

# Self-hosted / OpenAI-compatible LLM endpoint (optional). When set, both the
# query path (/ask) and the resolver/extraction path send chat completions
# here instead of openrouter.ai. Point at vLLM, Ollama's OpenAI shim, LiteLLM, …
# INFONA_LLM_BASE_URL=http://127.0.0.1:11434/v1
# Optional query-only override (falls back to INFONA_LLM_BASE_URL):
# INFONA_QUERY_BASE_URL=http://127.0.0.1:11434/v1

# Entity resolution (default ON). Multi-table FK joins rely on clean
# entities/<Type>/<id> URIs — mint-time signal fingerprints are OFF by default.
# INFONA_ER_ENABLED=0         # disable ER entirely
# INFONA_ER_FINGERPRINT=1     # restore mint-time URI hash (breaks multi-table FK joins)
# Optional embeddings endpoint / model (defaults follow INFONA_LLM_BASE_URL):
# INFONA_EMBED_BASE_URL=http://127.0.0.1:11434/v1
# INFONA_EMBED_MODEL=openai/text-embedding-3-small

# ---------------------------------------------------------------------------
# Offline / private-data dogfood (default OFF — no behavior change unless set)
# ---------------------------------------------------------------------------
# When enabled, outbound HTTP to non-allowlisted hosts fails closed
# (openrouter.ai, cerebras.ai, wikidata.org, arbitrary web fetch, …).
# Local graph backends and a self-hosted LLM on loopback stay reachable.
# INFONA_OFFLINE=1
# # alias: INFONA_OFFLINE=1
# Default allowlist: localhost, 127.0.0.1, ::1. Extend for a named local host:
# INFONA_OFFLINE_ALLOW_HOSTS=ollama.local,my-vllm.internal
# Pair with a local OpenAI-compatible stack, e.g.:
# INFONA_LLM_BASE_URL=http://127.0.0.1:11434/v1
# INFONA_EMBED_BASE_URL=http://127.0.0.1:11434/v1

# Optional: API key authentication (empty = open access, no auth needed)
# INFONA_API_KEYS={"my-key": "my-tenant"}

# Optional but recommended if you use the SEC EDGAR lambda
# (POST /functions/sec-latest-filing). SEC's fair-access policy asks automated
# clients to declare a working contact and throttles those that do not. Set
# YOUR OWN contact — unset falls back to an impersonal project-level UA.
# INFONA_SEC_USER_AGENT=Acme Corp ops@acme.com

# ---------------------------------------------------------------------------
# Bring-your-own-key registry sources (ONTA-340)
# ---------------------------------------------------------------------------
# Keyed entries in the built-in API-source registry are BRING-YOUR-OWN-KEY:
# each one stays DORMANT until you register for the provider's own (free) key
# and put it in your environment here. This OSS build never ships or implies a
# shared/platform key — "managed" keys (we provision, hold, meter, and bill the
# credential) are a premium/hosted-only feature. Unkeyed seeds
# (NPPES, ClinicalTrials.gov, Open Food Facts) need nothing.
#
# GEONAMES_USERNAME=...   # free GeoNames account — geocoding / place lookups.
#                         # Register: https://www.geonames.org/login
# FRED_API_KEY=...        # free St. Louis Fed key — U.S. national average prices
#                         # (BLS AP series). Register: https://fredaccount.stlouisfed.org/apikeys

# Optional: local key that envelope-encrypts per-workspace API credentials you
# store server-side (the tenant_custom secret store — still your OWN keys, just
# encrypted at rest). Required only to store secrets via the API-sources routes.
# INFONA_SECRETS_KEY=<base64 32-byte key>   # e.g. `openssl rand -base64 32`

# ---------------------------------------------------------------------------
# Graph IRI base (entity / type / named-graph namespace)
# ---------------------------------------------------------------------------
# Every entity, type, attribute, and named-graph URI is minted under this
# origin. IRIs are opaque primary keys (never HTTP-dereferenced).
#
# Default (when unset): https://graph.infona.ai
# Historical brand host: https://graph.infona.ai — pin this ONLY if you already
# have graphs minted under it and have not re-ingested.
#
# INFONA_IRI_BASE=https://graph.infona.ai
# # alias: INFONA_IRI_BASE=...
